amends "package://github.com/jdx/hk/releases/download/v2.5.0/hk@2.5.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.5.0/hk@2.5.0#/Builtins.pkl"

// Fast checks and fixers, run on every commit.
local pre_commit = new Mapping<String, Step> {
    ["check-added-large-files"] = (Builtins.check_added_large_files) { exclude = Regex(#"^\.hk/"#) }
    ["check-case-conflict"] = (Builtins.check_case_conflict) { exclude = Regex(#"^\.hk/"#) }
    ["check-executables-have-shebangs"] = (Builtins.check_executables_have_shebangs) { exclude = Regex(#"^\.hk/"#) }
    ["check-yaml"] = (Builtins.yamllint) { exclude = Regex(#"^\.hk/"#) }
    ["yamlfmt"] = (Builtins.yamlfmt) { exclude = Regex(#"^\.hk/"#) }
    // jq rewrites JSON with sorted keys. Skip files another tool owns:
    // renovate.json keeps its hand-ordered layout, and actions.lock.json is
    // regenerated by CI.
    ["check-json"] = (Builtins.jq) {
        exclude = Regex(#"(\.devcontainer|\.vscode)/.*\.json|^renovate\.json$|^\.github/actions\.lock\.json$|^\.hk/"#)
    }
    ["end-of-file-fixer"] = (Builtins.newlines) { exclude = Regex(#"^\.hk/"#) }
    ["fix-byte-order-marker"] = (Builtins.byte_order_marker) { exclude = Regex(#"^\.hk/"#) }
    ["fix-smart-quotes"] = (Builtins.fix_smart_quotes) { exclude = Regex(#"^\.hk/"#) }
    ["mixed-line-ending"] = (Builtins.mixed_line_ending) { exclude = Regex(#"^\.hk/"#) }
    ["trailing-whitespace"] = (Builtins.trailing_whitespace) { exclude = Regex(#"^\.hk/"#) }
    ["kingfisher"] = (Builtins.kingfisher) { exclude = Regex(#"^\.hk/"#) }
}

// Slower checks, run before push.
local pre_push = new Mapping<String, Step> {
    ["golangci-lint-config-verify"] { check = "golangci-lint config verify" }
    ["golangci-lint"] = (Builtins.golangci_lint) { exclude = Regex(#"^\.hk/"#) }
    // GitHub Actions hardening: pin actions to a SHA, lint the workflows, and run
    // zizmor's security static analysis. zizmor is pinned to offline mode here
    // (ZIZMOR_OFFLINE) so the pre-push hook stays fast and needs no token; the
    // lint-gha workflow runs the online audits in CI.
    ["pinact"] = Builtins.pinact
    ["actionlint"] = Builtins.actionlint
    ["zizmor"] = (Builtins.zizmor) { env { ["ZIZMOR_OFFLINE"] = "true" } }
    // Resolve the full workspace closure, then fail if that changed go.work or
    // go.work.sum, so the lockfile drift lands in the same commit as its cause.
    ["go-mod-download"] { check = "go mod download" }
    ["go-work-sum-clean"] {
        depends = List("go-mod-download")
        check = "git diff --exit-code go.work go.work.sum"
    }
}

hooks {
    ["commit-msg"] {
        steps {
            ["cocogitto-commit-msg"] = (Builtins.cocogitto_commit_msg)
        }
    }
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps {
            ...pre_commit
        }
    }
    ["pre-push"] {
        steps {
            ...pre_push
        }
    }
    ["check"] {
        steps {
            ...pre_commit
            ...pre_push
        }
    }
    ["fix"] {
        fix = true
        steps {
            ...pre_commit
            ...pre_push
        }
    }
}
